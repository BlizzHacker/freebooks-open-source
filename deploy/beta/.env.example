S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=freebooks
S3_FORCE_PATH_STYLE=true
SIGNUP_DISABLED=true
SIGNUP_ALLOWED_EMAILS=
SIGNUP_ALLOWED_DOMAINS=
