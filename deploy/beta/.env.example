HTTP_PORT=8740
BASE_URL=http://127.0.0.1:8740
DB_USER=freebooks
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_CHARSET=utf8mb4
SYSTEM_DB_NAME=freebooks_system
TENANT_DB_NAME_PERFIX=freebooks_tenant_
APP_JWT_SECRET=
PAYMENT_PROVIDER_ENCRYPTION_KEY=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
